# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# --- Safe to expose to the browser (NEXT_PUBLIC_*) ---
# The Supabase anon/publishable key is designed to be public.
# Protect data with Row Level Security in production (this demo disables RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (never use NEXT_PUBLIC_ for these) ---
# Used only in app/api/* routes; Next.js will not ship them to the client.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
